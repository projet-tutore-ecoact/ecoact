<?xml version="1.0" encoding="utf-8"?>

<!-- ScrollView pour pouvoir défiler si la page est trop grande -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Conteneur principal de l'écran de gestion des appareils -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- En-tête de la page avec le nom de l'application et le titre de l'écran -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nom de l'application -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EcoAct"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- Titre de la page -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Gestion des appareils"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Carte qui affiche la consommation totale des appareils enregistrés -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@color/primary_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Libellé de la consommation totale -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consommation totale"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- Valeur de la consommation totale en kWh par jour -->
            <TextView
                android:id="@+id/tv_total_consumption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 kWh/jour"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Nombre d'appareils enregistrés -->
            <TextView
                android:id="@+id/tv_device_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 appareil enregistré"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bouton qui permet d'afficher le formulaire d'ajout d'un appareil -->
        <Button
            android:id="@+id/btn_add_device"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_orange_background"
            android:text="+ Ajouter un appareil"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Formulaire pour ajouter ou modifier un appareil -->
        <LinearLayout
            android:id="@+id/layout_device_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Titre du formulaire, il change selon ajout ou modification -->
            <TextView
                android:id="@+id/tv_form_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajouter un appareil"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Label du champ type -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Type"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Champ pour saisir le type de l'appareil -->
            <EditText
                android:id="@+id/et_device_type"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@color/bg_light"
                android:hint="Ex: Télévision"
                android:inputType="textCapWords"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_light"
                android:textSize="14sp" />

            <!-- Label du champ référence -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Référence"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Champ pour écrire la référence ou la puissance de l'appareil -->
            <EditText
                android:id="@+id/et_device_reference"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@color/bg_light"
                android:hint="Ex: TV-55 ou 120W"
                android:inputType="text"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_light"
                android:textSize="14sp" />

            <!-- Label du champ durée d'utilisation -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Durée d'utilisation par jour"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Champ pour indiquer combien d'heures l'appareil est utilisé par jour -->
            <EditText
                android:id="@+id/et_daily_usage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@color/bg_light"
                android:hint="Ex: 3.5"
                android:inputType="numberDecimal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_light"
                android:textSize="14sp" />

            <!-- Texte qui affiche la consommation estimée après le calcul -->
            <TextView
                android:id="@+id/tv_calculated_consumption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Consommation estimée: 0 kWh/jour"
                android:textColor="@color/primary_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Message d'erreur affiché si les informations saisies ne sont pas correctes -->
            <TextView
                android:id="@+id/tv_device_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Ligne avec les boutons pour calculer et enregistrer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Bouton pour calculer la consommation de l'appareil -->
                <Button
                    android:id="@+id/btn_calculate_consumption"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_gray_background"
                    android:text="Calculer"
                    android:textColor="@color/text_gray" />

                <!-- Bouton pour enregistrer l'appareil dans la liste -->
                <Button
                    android:id="@+id/btn_save_device"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_orange_background"
                    android:text="Enregistrer"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Bouton pour annuler l'ajout ou la modification -->
            <Button
                android:id="@+id/btn_cancel_device"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_gray_background"
                android:text="Annuler"
                android:textColor="@color/text_gray" />
        </LinearLayout>

        <!-- Bloc qui affiche la liste des appareils de l'utilisateur -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Titre de la liste des appareils -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mes appareils"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Message affiché quand aucun appareil n'est enregistré -->
            <TextView
                android:id="@+id/tv_empty_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Aucun appareil enregistré."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <!-- Conteneur dans lequel les appareils ajoutés seront affichés -->
            <LinearLayout
                android:id="@+id/ll_devices_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>