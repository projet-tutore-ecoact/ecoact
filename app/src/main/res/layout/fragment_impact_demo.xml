<?xml version="1.0" encoding="utf-8"?>

<!-- Layout principal de l'écran Impact CO2 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- Titre affiché en haut de l'écran -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Impact CO2 Explorer"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <!-- Ligne qui contient les boutons pour choisir une catégorie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Bouton pour afficher les données liées au transport -->
        <Button
            android:id="@+id/btnLoadTransport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transport"
            android:layout_marginEnd="8dp"/>

        <!-- Bouton pour afficher les données liées au numérique -->
        <Button
            android:id="@+id/btnLoadEcv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Numérique"
            android:layout_marginEnd="8dp"/>

        <!-- Bouton pour afficher les données liées à l'alimentation -->
        <Button
            android:id="@+id/btnLoadAlimentation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alimentation"/>

    </LinearLayout>

    <!-- Barre de chargement affichée pendant la récupération des données -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginTop="16dp"/>

    <!-- Zone scrollable pour afficher les résultats récupérés -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="#FFFFFF"
        android:padding="8dp">

        <!-- Texte où les résultats de l'impact CO2 seront affichés -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Les résultats s'afficheront ici..."
            android:textColor="#333333"
            android:textSize="14sp"/>

    </ScrollView>

</LinearLayout>