                        android:layout_height="wrap_content"
                        android:text="Niveau 8 - Eco-Expert"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Barre qui montre l'avancement vers le niveau suivant -->
                    <ProgressBar
                        android:id="@+id/progress_profile_level"
