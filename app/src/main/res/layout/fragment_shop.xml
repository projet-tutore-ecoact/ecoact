<?xml version="1.0" encoding="utf-8"?>

<!-- ScrollView pour pouvoir défiler sur la page boutique -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Conteneur principal de la page boutique -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- En-tête orange avec le nom de l'application -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nom de l'application affiché en haut de l'écran -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EcoAct"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Bloc de présentation de la boutique éco-responsable -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@color/primary_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Icône de présentation de la boutique -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/app_name" />

            <!-- Titre de la boutique -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Boutique Éco-Responsable"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Description de la boutique -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Appareils recommandés pour économiser l'énergie"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Liste horizontale des catégories de produits -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <!-- Conteneur des boutons de catégories -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Bouton pour afficher tous les produits -->
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/button_orange_background"
                    android:text="Tous"
                    android:textColor="@color/white" />

                <!-- Bouton pour filtrer les réfrigérateurs -->
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/button_gray_background"
                    android:text="Réfrigérateur"
                    android:textColor="@color/text_gray" />

                <!-- Bouton pour filtrer les lave-linges -->
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/button_gray_background"
                    android:text="Lave-linge"
                    android:textColor="@color/text_gray" />

                <!-- Bouton pour filtrer les télévisions -->
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_gray_background"
                    android:text="Télévisé"
                    android:textColor="@color/text_gray" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Bloc d'information sur les partenaires certifiés -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/bg_light_blue"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Icône du bloc partenaires -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/app_name" />

            <!-- Texte expliquant que les produits viennent de partenaires certifiés -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:text="Nos Partenaires Certifiés - Tous les produits sont sélectionnés pour leur efficacité énergétique"
                android:textColor="@color/accent_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Carte d'un produit affiché dans la boutique -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Zone prévue pour l'image du produit -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/bg_light">

                <!-- Contenu affiché au centre de l'image du produit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Badge indiquant que le produit est sponsorisé -->
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_orange_background"
                        android:text="Sponsorisé"
                        android:textColor="@color/white"
                        android:textSize="10sp" />

                    <!-- Badge de classe énergétique du produit -->
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@color/accent_teal"
                        android:text="A+++"
                        android:textColor="@color/white"
                        android:textSize="10sp" />

                    <!-- Texte temporaire à la place de l'image du produit -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Produit"
                        android:textColor="@color/text_gray" />
                </LinearLayout>
            </FrameLayout>

            <!-- Bloc contenant les informations du produit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <!-- Marque du produit -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Samsung"
                    android:textColor="@color/primary_orange"
                    android:textSize="12sp" />

                <!-- Nom du produit -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Réfrigérateur EcoSmart A++"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Ligne qui affiche la note du produit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Étoiles de la note -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐⭐⭐⭐⭐"
                        android:textSize="12sp" />

                    <!-- Note numérique du produit -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="4.7"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Ligne qui affiche le bénéfice écologique du produit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Petite icône du bénéfice énergétique -->
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@string/app_name" />

                    <!-- Texte indiquant l'économie d'énergie -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="Économie de 45% d'énergie"
                        android:textColor="@color/accent_teal"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Ligne avec le prix et le bouton pour voir l'offre -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Prix du produit -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="899€"
                        android:textColor="@color/primary_orange"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Bouton pour accéder à l'offre du produit -->
                    <Button
                        android:id="@+id/btn_view_offer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_orange_background"
                        android:paddingLeft="24dp"
                        android:paddingRight="24dp"
                        android:text="Voir l'offre"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>