<?xml version="1.0" encoding="utf-8"?>

<!-- ScrollView pour permettre de faire défiler la page si tout ne rentre pas à l'écran -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Conteneur principal de l'écran d'accueil / consommation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- En-tête orange avec le nom de l'application -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nom de l'application affiché en haut de la page -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EcoAct"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Ligne qui affiche les trois cartes de consommation : électricité, gaz et eau -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Carte qui affiche la consommation d'électricité -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/card_background_green"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Icône de la carte électricité -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/app_name" />

                <!-- Nom de la catégorie -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Electricité"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <!-- Valeur de consommation électrique -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="105 kWh"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Petit indicateur d'évolution de la consommation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/accent_teal"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <!-- Pourcentage d'évolution pour l'électricité -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+8%"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Carte qui affiche la consommation de gaz -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/card_background_orange"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Icône de la carte gaz -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/app_name" />

                <!-- Nom de la catégorie -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gaz"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <!-- Valeur de consommation du gaz -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="57 m³"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Petit indicateur d'évolution de la consommation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/primary_orange"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <!-- Pourcentage d'évolution pour le gaz -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+5%"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Carte qui affiche la consommation d'eau -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/card_background_blue"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Icône de la carte eau -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/app_name" />

                <!-- Nom de la catégorie -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eau"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <!-- Valeur de consommation d'eau -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="41 m³"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Petit indicateur d'évolution de la consommation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/accent_blue"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <!-- Pourcentage d'évolution pour l'eau -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="-8%"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Boutons pour choisir la période affichée dans les statistiques -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Bouton pour afficher les données de la semaine -->
            <Button
                android:id="@+id/btn_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_orange_background"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:text="Semaine"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- Bouton pour afficher les données du mois -->
            <Button
                android:id="@+id/btn_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_gray_background"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:text="Mois"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Zone prévue pour afficher le graphique de consommation -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/white">

            <!-- Texte temporaire affiché à la place du graphique -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Graphique de Consommation"
                android:textColor="@color/text_gray" />
        </FrameLayout>

        <!-- Bloc qui affiche la répartition de la consommation sous forme de camembert -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:layout_margin="16dp">

            <!-- Titre de la partie répartition de la consommation -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Répartition de la Consommation"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Zone prévue pour afficher le graphique en camembert -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_margin="16dp">

                <!-- Texte temporaire affiché à la place du camembert -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Camembert"
                    android:textColor="@color/text_gray" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>