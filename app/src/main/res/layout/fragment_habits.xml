<?xml version="1.0" encoding="utf-8"?>

<!-- ScrollView pour pouvoir défiler si le contenu dépasse la taille de l'écran -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Conteneur principal de l'écran de gestion des habitudes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- En-tête de la page avec le nom de l'application et le titre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nom de l'application -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EcoAct"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- Titre de l'écran -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Gestion des habitudes"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Carte qui affiche le score global des habitudes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@color/accent_teal"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Libellé du score global -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Score global"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- Points obtenus par rapport au total possible -->
            <TextView
                android:id="@+id/tv_habit_points"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 / 0 pts"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Nombre d'habitudes enregistrées -->
            <TextView
                android:id="@+id/tv_habit_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 habitude enregistrée"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <!-- Titre de la progression -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Progression"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <!-- Barre qui affiche la progression des habitudes -->
            <ProgressBar
                android:id="@+id/progress_habits"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0" />

            <!-- Pourcentage de progression affiché à droite -->
            <TextView
                android:id="@+id/tv_habits_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0%"
                android:textAlignment="textEnd"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bouton pour afficher le formulaire d'ajout d'une habitude -->
        <Button
            android:id="@+id/btn_add_habit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/accent_blue"
            android:text="+ Ajouter une habitude"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Formulaire qui permet d'ajouter une habitude -->
        <LinearLayout
            android:id="@+id/layout_habit_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Titre du formulaire -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajouter une habitude"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Label du choix de l'habitude -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Habitude"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Liste déroulante pour choisir le type d'habitude -->
            <Spinner
                android:id="@+id/spinner_habit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/bg_light"
                android:minHeight="56dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:popupBackground="@color/white" />

            <!-- Label du choix de la fréquence -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Fréquence"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Liste déroulante pour choisir la fréquence de l'habitude -->
            <Spinner
                android:id="@+id/spinner_frequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/bg_light"
                android:minHeight="56dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:popupBackground="@color/white" />

            <!-- Message d'erreur affiché si le formulaire n'est pas correct -->
            <TextView
                android:id="@+id/tv_habit_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Ligne qui contient les boutons du formulaire -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Bouton pour enregistrer l'habitude sélectionnée -->
                <Button
                    android:id="@+id/btn_save_habit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_orange_background"
                    android:text="Enregistrer"
                    android:textColor="@color/white" />

                <!-- Bouton pour annuler l'ajout de l'habitude -->
                <Button
                    android:id="@+id/btn_cancel_habit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_gray_background"
                    android:text="Annuler"
                    android:textColor="@color/text_gray" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bloc qui affiche la liste des habitudes ajoutées -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Titre de la liste des habitudes -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mes habitudes"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Message affiché quand aucune habitude n'est enregistrée -->
            <TextView
                android:id="@+id/tv_empty_habits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Aucune habitude enregistrée."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <!-- Conteneur où les habitudes seront ajoutées dynamiquement -->
            <LinearLayout
                android:id="@+id/ll_habits_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Bloc qui affiche les scores regroupés par catégorie -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Titre de la section des scores par catégorie -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scores par catégorie"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Message affiché quand il n'y a pas encore de scores -->
            <TextView
                android:id="@+id/tv_empty_scores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ajoutez des habitudes pour voir les scores."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <!-- Conteneur où les scores par catégorie seront affichés -->
            <LinearLayout
                android:id="@+id/ll_category_scores_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>