<?xml version="1.0" encoding="utf-8"?>
<!--
    CONTENEUR PRINCIPAL : ScrollView
    Permet à tout le contenu de défiler verticalement si l'écran est trop petit.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:clipToPadding="false"
    android:paddingBottom="96dp">

    <!--
        LAYOUT VERTICAL PRINCIPAL
        Contient toutes les sections de l'écran organisées en colonne.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== SECTION 1 : EN-TÊTE ORANGE ===== -->
        <!-- Bannière en haut avec le nom de l'application -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EcoAct"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Suivi de consommation électrique"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== SECTION 2 : CARTE DE CONSOMMATION ACTUELLE ===== -->
        <!-- Affiche les chiffres de consommation en gros caractères -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/card_background_green"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consommation actuelle"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <!-- Valeur principale : kWh par jour (modifiable en code) -->
            <TextView
                android:id="@+id/tv_electricity_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 kWh/jour"
                android:textColor="@color/text_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Consommation totale sur la période (modifiable en code) -->
            <TextView
                android:id="@+id/tv_period_consumption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 kWh sur la période"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <!-- Badge de tendance : Stable / Hausse / Baisse (modifiable en code) -->
            <TextView
                android:id="@+id/tv_electricity_trend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/accent_teal"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:text="Stable"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== SECTION 3 : BOUTONS DE PÉRIODE ===== -->
        <!-- Permet de basculer entre vue 7 jours / 30 jours -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/btn_week"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_orange_background"
                android:text="7 jours"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_month"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/button_gray_background"
                android:text="30 jours"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ===== SECTION 4 : CARTE ÉVOLUTION (GRAPHIQUE) ===== -->
        <!-- Conteneur pour un graphique montrant l'évolution dans le temps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Évolution"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Texte de résumé (ex: "En hausse de 5%") -->
            <TextView
                android:id="@+id/tv_comparison_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <!-- Zone où sera dessiné le graphique (ex: MPAndroidChart) -->
            <FrameLayout
                android:id="@+id/chart_container"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- ===== SECTION 5 : CARTE RÉPARTITION PAR APPAREIL (CAMEMBERT) ===== -->
        <!-- Conteneur pour un graphique circulaire montrant la répartition -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Répartition par appareil"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Texte de résumé (ex: "Réfrigérateur: 40%") -->
            <TextView
                android:id="@+id/tv_distribution_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <!-- Zone où sera dessiné le graphique camembert -->
            <FrameLayout
                android:id="@+id/pie_container"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>