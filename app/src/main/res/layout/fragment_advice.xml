<?xml version="1.0" encoding="utf-8"?>

<!-- ScrollView pour pouvoir faire défiler la page si le contenu dépasse l'écran -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="96dp">

    <!-- Conteneur vertical principal de la page conseils et marketplace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Titre principal de l'écran -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Conseils &amp; marketplace &#233;co"
            android:textColor="@color/text_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Petit texte descriptif sous le titre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="Conseils IA et appareils partenaires adapt&#233;s &#224; votre profil."
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <!-- Bloc qui contient la partie des conseils personnalisés -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_advice_panel"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Titre de la section conseils personnalisés -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Conseils personnalis&#233;s"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Description de la section conseils -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Mistral analyse vos appareils et habitudes, puis propose des actions concr&#232;tes."
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <!-- Bouton qui permet de générer les conseils avec l'IA -->
            <Button
                android:id="@+id/btn_generate_advice"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:backgroundTint="@color/primary_orange"
                android:text="G&#233;n&#233;rer mes conseils"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <!-- Barre de chargement affichée pendant la génération des conseils -->
            <ProgressBar
                android:id="@+id/progress_advice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- Message affiché s'il y a une erreur pendant la génération -->
            <TextView
                android:id="@+id/tv_advice_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="#E53935"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Texte qui affiche les conseils générés ou le message par défaut -->
            <TextView
                android:id="@+id/tv_advice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="Appuyez sur le bouton pour g&#233;n&#233;rer vos conseils personnalis&#233;s."
                android:textColor="@color/text_dark"
                android:textSize="15sp" />

            <!-- Conteneur dans lequel les cartes de conseils peuvent être ajoutées dynamiquement -->
            <LinearLayout
                android:id="@+id/layout_advice_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Bloc marketplace qui sert à proposer des appareils écologiques -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_marketplace_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Titre de la section des appareils suggérés -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Appareils sugg&#233;r&#233;s"
                android:textColor="@color/text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Texte de statut pour indiquer l'état de la marketplace -->
            <TextView
                android:id="@+id/tv_marketplace_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <!-- Bouton qui lance la suggestion d'appareils -->
            <Button
                android:id="@+id/btn_suggest_devices"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/primary_orange"
                android:text="Sugg&#233;rer des appareils"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <!-- Chargement affiché pendant la recherche des appareils suggérés -->
            <ProgressBar
                android:id="@+id/progress_marketplace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Conteneur où les produits de la marketplace seront affichés -->
        <LinearLayout
            android:id="@+id/layout_marketplace_products"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>